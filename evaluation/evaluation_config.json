{
  "evaluation_config": {
    "version": "1.0.0",
    "name": "EduMate RAG Evaluation Framework",
    "description": "Professional RAG evaluation framework for CS course materials",
    
    "retrieval_evaluation": {
      "enabled": true,
      "metrics": [
        {
          "name": "precision_at_k",
          "k_values": [1, 3, 5, 10],
          "description": "% of top-K retrieved docs that are relevant"
        },
        {
          "name": "recall_at_k",
          "k_values": [5, 10, 20],
          "description": "% of all relevant docs found in top-K"
        },
        {
          "name": "mrr",
          "description": "Mean Reciprocal Rank - position of first relevant doc"
        },
        {
          "name": "ndcg_at_k",
          "k_values": [5, 10],
          "description": "Normalized Discounted Cumulative Gain"
        }
      ],
      "targets": {
        "precision_at_3": 0.70,
        "recall_at_5": 0.60,
        "mrr": 0.75,
        "ndcg_at_10": 0.70
      }
    },
    
    "generation_evaluation": {
      "enabled": true,
      "metrics": [
        {
          "name": "faithfulness",
          "scale": "0-1",
          "description": "Answer is grounded in retrieved sources (no hallucinations)"
        },
        {
          "name": "relevance",
          "scale": "0-1",
          "description": "Answer addresses the question"
        },
        {
          "name": "completeness",
          "scale": "0-1",
          "description": "Answer provides sufficient information"
        },
        {
          "name": "source_accuracy",
          "scale": "0-1",
          "description": "Cited sources actually contain the information"
        }
      ],
      "evaluation_method": "manual_and_llm",
      "targets": {
        "faithfulness": 0.95,
        "relevance": 0.90,
        "completeness": 0.80,
        "source_accuracy": 0.95
      }
    },
    
    "performance_evaluation": {
      "enabled": true,
      "metrics": [
        {
          "name": "latency",
          "unit": "milliseconds",
          "description": "Query response time"
        },
        {
          "name": "throughput",
          "unit": "queries/second",
          "description": "System throughput"
        },
        {
          "name": "memory_usage",
          "unit": "MB",
          "description": "Memory footprint"
        }
      ],
      "targets": {
        "avg_latency_ms": 3000,
        "p95_latency_ms": 5000,
        "throughput_qps": 0.5,
        "memory_usage_mb": 2048
      }
    },
    
    "dataset_config": {
      "dataset_path": "evaluation/datasets/rag_evaluation_dataset_v1.json",
      "train_test_split": 0.8,
      "min_qa_pairs": 50,
      "max_qa_pairs": 100,
      "categories": [
        "Computer Architecture",
        "Data Structures & Algorithms",
        "Operating Systems",
        "Object-Oriented Programming",
        "Machine Learning"
      ]
    },
    
    "inference_config": {
      "retrieval_top_k": 5,
      "max_retrieved_docs": 5,
      "embedding_model": "all-MiniLM-L6-v2",
      "llm_model": "llama-3.3-70b-versatile",
      "temperature": 0.7,
      "max_tokens": 500
    },
    
    "output_config": {
      "results_dir": "evaluation/results",
      "report_formats": ["json", "html", "csv"],
      "save_individual_results": true,
      "visualizations": true
    }
  },
  
  "evaluation_phases": {
    "phase_1": {
      "name": "Dataset Preparation",
      "status": "in_progress",
      "tasks": [
        "Extract PDF content",
        "Generate QA pairs",
        "Create ground truth annotations",
        "Save structured dataset"
      ]
    },
    "phase_2": {
      "name": "Metrics Calculation",
      "status": "pending",
      "tasks": [
        "Run RAG on test queries",
        "Calculate retrieval metrics",
        "Calculate generation metrics",
        "Calculate performance metrics"
      ]
    },
    "phase_3": {
      "name": "Analysis & Reporting",
      "status": "pending",
      "tasks": [
        "Aggregate results",
        "Generate reports",
        "Identify weaknesses",
        "Create visualizations"
      ]
    },
    "phase_4": {
      "name": "Optimization",
      "status": "pending",
      "tasks": [
        "Fix identified issues",
        "Retune parameters",
        "Re-evaluate",
        "Document improvements"
      ]
    }
  }
}
