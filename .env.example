# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
# Optional: second Groq key for automatic rate-limit rotation.
# When GROQ_API_KEY hits its RPM/TPM limit, the system retries the same
# request with this key instead of returning a 503 error.
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional judge model for generation_eval.py supplementary scoring.
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile

# Vector Store Configuration
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=https://your-qdrant-cloud-url
QDRANT_API_KEY=your-qdrant-api-key

# ChromaDB Configuration
CHROMA_DB_PATH=/tmp/edumate/chroma_db
CONVERSATION_DIR=/tmp/edumate/conversations

# API Configuration
API_HOST=localhost
API_PORT=8000
DEBUG=True
ADMIN_KEY=change-this-admin-key

# PDF Configuration
PDF_FOLDER_PATH=./assets/course_pdfs
